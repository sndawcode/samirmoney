# Copy to .env.local for development. Never commit real values.
NEXT_PUBLIC_SITE_URL=https://samirmoney.com     # canonical domain (Appendix D #1)
CONTACT_TO_EMAIL=                               # inbox that receives contact and deletion requests
CONTACT_FROM_EMAIL=no-reply@samirmoney.com      # verified Resend sender
RESEND_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=samirmoney.com     # leave empty to disable analytics
CRM_WEBHOOK_URL=                                # optional
STRICT_CONTENT=0                                # 1 in production CI: fails on any TODO(client)
SITE_STAGE=                                     # "production" on non-Vercel hosts for the live site
