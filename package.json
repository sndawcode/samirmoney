{
  "name": "samir-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "assets:drive": "bash scripts/fetch-drive.sh",
    "assets:legacy": "bash scripts/fetch-legacy-assets.sh",
    "images": "node scripts/optimize-images.mjs assets/selection.json",
    "check:content": "tsx scripts/check-content.ts",
    "check:links": "linkinator http://localhost:3000 --recurse --skip '^(?!http://localhost)'",
    "assets:derive": "node scripts/prepare-legacy.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "1.6.2",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "resend": "6.33.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "linkinator": "8.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  }
}
