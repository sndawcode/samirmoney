{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start --port 3300",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3300/",
        "http://localhost:3300/particuliers",
        "http://localhost:3300/professionnels",
        "http://localhost:3300/raps",
        "http://localhost:3300/services",
        "http://localhost:3300/developpeurs",
        "http://localhost:3300/a-propos",
        "http://localhost:3300/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
